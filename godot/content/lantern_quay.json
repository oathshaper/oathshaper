    {
      "id": "mara_office",
      "speaker": "Mara",
      "text": "Thank you. I'll stay here in case someone else needs help. Call if she's hurt.",
      "return_to": "mara_greeting"
    },
    {
      "id": "clerk_robbery",
      "speaker": "Clerk",
      "text": "A man in a red coat, with two iron guards behind him. He emptied the chest into a pouch and ran east. That's the dockworkers' pay. Tell Mara what happened, then find Ivo. He went after the thief.",
      "return_to": "clerk_greeting"
    },
    {
      "id": "clerk_paid",
      "speaker": "Clerk",
      "text": "The whole payroll. Thank you. Mara, here's your week's wages. Buy the tower oil before anything else; I don't want another night like this.",
      "return_to": "clerk_greeting"
    },
    {
      "id": "pay_loot",
