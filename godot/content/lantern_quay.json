    {
      "id": "ivo_gate_opened",
      "speaker": "Ivo",
      "text": "I'll lift the chain. Stay together. Those guards hit hard, and Mara needs room to work.",
      "return_to": "ivo_gate"
    },
    {
      "id": "ivo_gate_history",
      "speaker": "Ivo",
      "text": "One of his guards nearly took my head off. I couldn't fight both at once. Get Mara.\n\nWe'll need someone who can tend a wound.",
      "return_to": "ivo_gate"
    },
    {
      "id": "ivo_sentries",
