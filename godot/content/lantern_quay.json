    },
    {
      "id": "clerk_town",
      "speaker": "Clerk",
      "text": "Pickpockets, sometimes. Armed robbery in my office? Never. With the tower out he got across the court before I saw him coming.",
      "return_to": "clerk_greeting"
    },
