              "kind": "flag",
              "id": "pay_returned",
              "value": true
            }
          ],
          "text": "We've been paid, and the tower's burning again. I can see right across the quay from here."
        },
        {
          "when": [
            {
              "kind": "flag",
              "id": "pay_recovered",
              "value": true
            }
          ],
          "text": "Let's get this back to the clerk. The others are still waiting to be paid."
