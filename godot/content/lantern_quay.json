            {
              "kind": "flag",
              "id": "pay_returned",
              "value": true
            }
          ],
          "text": "I've counted it twice. Nobody will lose their wages. We'll have that lock replaced in the morning."
        },
        {
          "when": [
            {
              "kind": "flag",
              "id": "pay_recovered",
              "value": true
            }
          ],
          "text": "That pouch has the quay stamp on it. You found him! Let me count the money."
