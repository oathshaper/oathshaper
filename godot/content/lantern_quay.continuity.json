      "when_any": [
        [
          {
            "kind": "flag",
            "id": "raiders_defeated",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "pay_recovered",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": true
          }
        ]
      ],
      "absent_choices": [
        "ask_robbery"
      ],
      "forbidden_text": [
        "Ivo chased the thief east"
      ]
    },
    {
