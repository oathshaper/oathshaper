{
  "schema": 1,
  "story_id": "lantern_quay",
  "rules": [
    {
      "id": "tower-light-invalidates-darkness",
      "node": "mara_greeting",
      "reason": "The tower is lit by shared oil or the returned payroll. Present-tense darkness topics are obsolete.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "oil_shared",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": true
          }
        ]
      ],
      "absent_choices": [
        "ask_lamp"
      ],
      "forbidden_text": [
        "tower's gone dark",
        "tower is dark"
      ]
    },
    {
      "id": "clerk-visit-invalidates-offer-to-check",
      "node": "mara_greeting",
      "reason": "The player has already obtained the clerk's account of the robbery.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "robbery_known",
            "value": true
          }
        ]
      ],
      "absent_choices": [
        "check_office"
      ]
    },
    {
      "id": "report-to-mara-has-reply",
      "node": "mara_greeting",
      "reason": "A player who heard the clerk's account can reassure Mara and ask her to help.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "robbery_known",
            "value": true
          },
          {
            "kind": "flag",
            "id": "mara_recruited",
            "value": false
          },
          {
            "kind": "flag",
            "id": "raiders_defeated",
            "value": false
          },
          {
            "kind": "flag",
            "id": "pay_recovered",
            "value": false
          },
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": false
          }
        ]
      ],
      "enabled_choices": [
        "accept_help"
      ]
    },
    {
      "id": "victory-retires-ivo-preparation",
      "node": "ivo_gate",
      "reason": "After the guards are defeated, Ivo can discuss the recovery, not entering a guarded garden.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "raiders_defeated",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "pay_recovered",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": true
          }
        ]
      ],
      "absent_choices": [
        "open_gate",
        "ask_about_gate",
        "ask_sentries"
      ],
      "forbidden_text": [
        "he's got two mechanical guards",
        "keep the guards busy",
        "get mara"
      ]
    },
    {
      "id": "recruitment-retires-fetching-mara",
      "node": "ivo_gate",
      "reason": "Mara has already agreed to come; Ivo must not send the player to fetch her again.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "mara_recruited",
            "value": true
          }
        ]
      ],
      "absent_choices": [
        "ask_about_gate"
      ]
    },
    {
      "id": "victory-retires-mara-rendezvous",
      "node": "mara_greeting",
      "reason": "After the battle Mara is helping recover the pouch, not meeting the player at the gate.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "raiders_defeated",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "pay_recovered",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": true
          }
        ]
