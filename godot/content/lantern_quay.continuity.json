      ]
    },
    {
      "id": "ivo-does-not-inherit-offscreen-payout-knowledge",
      "node": "ivo_gate",
      "reason": "Ivo remains guarding the prisoner; he can observe the beacon but not the clerk taking payment.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": true
          }
        ]
      ],
      "forbidden_text": [
