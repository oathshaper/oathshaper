      "absent_choices": [
        "check_office",
        "accept_help",
        "ask_theft",
        "ask_pay",
        "ask_for_favor",
        "ask_lamp",
        "share_oil",
        "keep_oil"
      ],
      "forbidden_text": [
        "I'll meet you at the garden gate",
        "Ivo will know where the thief went",
        "Is the clerk hurt?"
      ]
    },
    {
      "id": "victory-retires-clerk-pursuit",
      "node": "clerk_greeting",
