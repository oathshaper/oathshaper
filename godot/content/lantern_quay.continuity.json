      "when_any": [
        [
          {
            "kind": "flag",
            "id": "robbery_known",
            "value": true
          }
        ],
        [
          {
            "kind": "flag",
            "id": "mara_recruited",
            "value": true
          }
        ]
      ],
      "absent_choices": [
        "ask_robbery"
      ]
    },
    {
      "id": "recruitment-retires-mara-discovery",
      "node": "mara_greeting",
