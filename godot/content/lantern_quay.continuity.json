      "when_any": [
        [
          {
            "kind": "flag",
            "id": "mara_recruited",
            "value": true
          }
        ]
      ],
      "forbidden_text": [
        "Tell her I'm safe",
        "Mara was waiting"
      ]
    },
    {
      "id": "vendor-does-not-inherit-offscreen-payout-knowledge",
      "node": "vendor_greeting",
      "reason": "The vendor sees the tower; nobody has told him about the payout.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": true
          }
        ]
      ],
      "forbidden_text": [
