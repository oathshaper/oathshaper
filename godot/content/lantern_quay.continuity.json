      "node": "mara_greeting",
      "reason": "The robbery_known flag is Tessa's knowledge, not Mara's. Tessa tells Mara when recruiting her.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "mara_recruited",
            "value": false
          },
          {
            "kind": "flag",
            "id": "gate_open",
            "value": false
          },
          {
            "kind": "flag",
            "id": "raiders_defeated",
            "value": false
          },
          {
            "kind": "flag",
            "id": "pay_recovered",
            "value": false
          },
          {
            "kind": "flag",
            "id": "pay_returned",
            "value": false
          }
        ]
      ],
      "forbidden_text": [
        "The payroll?",
        "whole week's wages"
      ]
    },
    {
      "id": "open-gate-retires-mara-rendezvous",
      "node": "mara_greeting",
      "reason": "The party has already assembled and opened the gate.",
      "when_any": [
        [
          {
            "kind": "flag",
            "id": "gate_open",
            "value": true
          }
        ]
      ],
      "absent_choices": [
        "ask_for_favor"
      ],
      "forbidden_text": [
        "I'll meet you at the garden gate"
      ]
    },
    {
